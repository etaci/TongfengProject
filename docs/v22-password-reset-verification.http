@baseUrl = http://localhost:8080

### 1. 注册一个正式账号
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "nickname": "v22-user",
  "accountType": "EMAIL",
  "account": "v22-user@example.com",
  "password": "Password123",
  "confirmPassword": "Password123",
  "consent": {
    "consentVersion": "v1.0",
    "privacyPolicyVersion": "privacy-v1.0",
    "privacyAccepted": true,
    "termsAccepted": true,
    "medicalDataAuthorized": true,
    "familyCollaborationAuthorized": true,
    "notificationAuthorized": true
  }
}

> {%
client.global.set("token", response.body.data.token);
%}

### 2. 查看当前账号验证状态，预期 verified=false
GET {{baseUrl}}/api/v1/auth/account-verification/status
Authorization: Bearer {{token}}

### 3. 请求找回密码验证码
POST {{baseUrl}}/api/v1/auth/verification-codes/request
Content-Type: application/json

{
  "purpose": "PASSWORD_RESET",
  "accountType": "EMAIL",
  "account": "v22-user@example.com"
}

> {%
client.global.set("reset_code", response.body.data.simulatedCode);
%}

### 4. 使用验证码重置密码
POST {{baseUrl}}/api/v1/auth/password-reset/confirm
Content-Type: application/json

{
  "accountType": "EMAIL",
  "account": "v22-user@example.com",
  "verificationCode": "{{reset_code}}",
  "newPassword": "Password456",
  "confirmPassword": "Password456"
}

### 5. 使用新密码重新登录
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "accountType": "EMAIL",
  "account": "v22-user@example.com",
  "password": "Password456"
}

> {%
client.global.set("token", response.body.data.token);
%}

### 6. 请求账号验证验证码
POST {{baseUrl}}/api/v1/auth/account-verification/request
Authorization: Bearer {{token}}

> {%
client.global.set("verify_code", response.body.data.simulatedCode);
%}

### 7. 提交账号验证验证码
POST {{baseUrl}}/api/v1/auth/account-verification/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "verificationCode": "{{verify_code}}"
}

### 8. 再次查看验证状态，预期 verified=true
GET {{baseUrl}}/api/v1/auth/account-verification/status
Authorization: Bearer {{token}}

### 9. 查看当前会话，预期 accountVerified=true
GET {{baseUrl}}/api/v1/auth/session
Authorization: Bearer {{token}}
